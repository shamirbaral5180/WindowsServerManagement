<UserControl x:Class="WindowsServerManagement.App.Views.WebsitesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:WindowsServerManagement.App.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
        <conv:ConnectionStateToBrushConverter x:Key="StateBrush" />
        <conv:BooleanToBrushConverter x:Key="BooleanBrush" />
    </UserControl.Resources>

    <Grid Margin="30,24,30,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="IIS Websites" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="Create and manage websites on the selected remote Windows Server."
                           Style="{StaticResource PageSubtitleText}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Connect" Command="{Binding ConnectServerCommand}" Margin="0,0,10,0"
                        Visibility="{Binding IsServerConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                <Button Content="+  Create website" Style="{StaticResource PrimaryButton}" Command="{Binding CreateWebsiteCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid MaxWidth="460" HorizontalAlignment="Left">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MinHeight="38" Padding="34,7,10,7" />
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" />
                <TextBlock Text="Search websites..." Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center" Margin="34,0,0,0" IsHitTestVisible="False"
                           Visibility="{Binding SearchText, Converter={StaticResource StringToVisibility}, ConverterParameter=Invert}" />
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="{Binding FilteredCountText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                <Button Content="Cancel" Command="{Binding CancelOperationCommand}" Style="{StaticResource SubtleButton}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <Border Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,8"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource DangerBrush}"
                               FontSize="14" VerticalAlignment="Top" Margin="0,1,8,0" />
                    <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="2" Content="&#xE711;" Style="{StaticResource IconButton}" Command="{Binding ClearNotificationsCommand}"
                            Width="24" Height="24" MinHeight="24" />
                </Grid>
            </Border>
            <Border Background="{DynamicResource SuccessSoftBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,8"
                    Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SuccessBrush}"
                               FontSize="14" VerticalAlignment="Top" Margin="0,1,8,0" />
                    <TextBlock Grid.Column="1" Text="{Binding SuccessMessage}" Foreground="{DynamicResource SuccessBrush}"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="2" Content="&#xE711;" Style="{StaticResource IconButton}" Command="{Binding ClearNotificationsCommand}"
                            Width="24" Height="24" MinHeight="24" />
                </Grid>
            </Border>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="390" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding WebsitesView}" SelectedItem="{Binding SelectedWebsite, Mode=TwoWay}"
                              Margin="0,2,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Website" Binding="{Binding Name}" Width="1.3*" />
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="80" />
                            <DataGridTextColumn Header="Server" Binding="{Binding ServerName}" Width="130" />
                            <DataGridTextColumn Header="Binding" Binding="{Binding BindingsSummary}" Width="1.4*" />
                            <DataGridTextColumn Header="Application pool" Binding="{Binding ApplicationPool}" Width="1.2*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}"
                          Visibility="{Binding HasVisibleWebsites, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                          IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                                       Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource MutedText}" TextAlignment="Center"
                                       FontSize="13" Margin="0,12,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasSelectedWebsite, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                        <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                                   Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Select a website" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
                        <TextBlock Text="Details and actions appear here." Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasSelectedWebsite, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel DataContext="{Binding SelectedWebsite}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ServerName}" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource StatusPill}"
                                        Background="{DynamicResource SurfaceAltBrush}" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding State}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding IsRunning, Converter={StaticResource BooleanBrush}}" />
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource SectionSeparator}" />

                            <TextBlock Text="Physical path" Style="{StaticResource FieldLabelText}" />
                            <TextBlock Text="{Binding PhysicalPath}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />

                            <TextBlock Text="Application pool" Style="{StaticResource FieldLabelText}" Margin="0,14,0,6" />
                            <TextBlock Text="{Binding ApplicationPool}" FontSize="12" />

                            <TextBlock Text="Bindings" Style="{StaticResource FieldLabelText}" Margin="0,14,0,6" />
                            <ItemsControl ItemsSource="{Binding Bindings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="9,6" Margin="0,0,0,5">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Display}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding BindingInformation}" FontFamily="Consolas" FontSize="10"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Style="{StaticResource SectionSeparator}" />

                            <TextBlock Text="Actions" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />
                            <UniformGrid Columns="2">
                                <Button Content="Start" Style="{StaticResource PrimaryButton}" Margin="0,0,5,8"
                                        Command="{Binding DataContext.StartWebsiteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                <Button Content="Stop" Margin="0,0,5,8"
                                        Command="{Binding DataContext.StopWebsiteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                <Button Content="Restart" Margin="0,0,5,8"
                                        Command="{Binding DataContext.RestartWebsiteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                <Button Content="Open in browser" Margin="0,0,5,8"
                                        Command="{Binding DataContext.OpenInBrowserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <Button Content="Edit bindings" Margin="0,0,5,0"
                                        Command="{Binding DataContext.EditBindingsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <Button Content="Configuration" Margin="0,0,5,0"
                                        Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </UniformGrid>
                            <Button Content="Delete website" Style="{StaticResource DangerButton}" Margin="0,12,0,0"
                                    Command="{Binding DataContext.DeleteWebsiteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource HelpText}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Ellipse Width="7" Height="7" Fill="{Binding SelectedServer.ConnectionState, Converter={StaticResource StateBrush}}"
                         VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="{Binding ServerName}" Style="{StaticResource HelpText}" />
                <TextBlock Text="  ·  " Style="{StaticResource HelpText}" />
                <TextBlock Text="{Binding ServerEndpoint}" Style="{StaticResource HelpText}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
