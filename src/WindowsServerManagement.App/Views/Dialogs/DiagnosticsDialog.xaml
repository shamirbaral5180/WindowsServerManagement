<Window x:Class="WindowsServerManagement.App.Views.Dialogs.DiagnosticsDialog"
        Title="Connection diagnostics"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:WindowsServerManagement.App.Converters"
        Width="680" Height="720" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:BooleanToBrushConverter x:Key="BooleanBrush" />
        <conv:BooleanToGlyphConverter x:Key="BooleanGlyph" />
    </Window.Resources>
    <Border Margin="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.3" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Background="{DynamicResource TitleBarBrush}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource BrandGradientBrush}"
                        Margin="18,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Connection diagnostics" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ServerName}" Style="{StaticResource HelpText}" Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Content="&#xE711;" Style="{StaticResource IconButton}" Width="32" Height="32"
                        Margin="0,0,14,0" Click="Close_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16,24,12">
                <StackPanel>
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="20" Margin="0,1,10,0"
                                           Foreground="{Binding IsReady, Converter={StaticResource BooleanBrush}}" />
                                <TextBlock Text="{Binding Headline}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                                           Foreground="{Binding IsReady, Converter={StaticResource BooleanBrush}}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding Fingerprint}" FontFamily="Consolas" FontSize="11"
                                       Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Checks" Style="{StaticResource SectionTitleText}" Margin="0,18,0,10" />
                    <Border Style="{StaticResource Card}" Padding="0">
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="42">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Ok, Converter={StaticResource BooleanGlyph}}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Foreground="{Binding Ok, Converter={StaticResource BooleanBrush}}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Value}" VerticalAlignment="Center" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="{Binding Ok, Converter={StaticResource BooleanBrush}}"
                                                   Margin="20,0,16,0" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <StackPanel Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Required actions" Style="{StaticResource SectionTitleText}" Margin="0,18,0,10" />
                        <Border Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14">
                            <ItemsControl ItemsSource="{Binding Problems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource DangerBrush}"
                                                       FontSize="12" Margin="0,2,8,0" />
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"
                                                       FontSize="12" MaxWidth="520" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="Administrative IIS operations require OpenSSH Server and an elevated SSH account. See docs/REMOTE_SERVER_SETUP.md in the solution for setup instructions."
                               Style="{StaticResource HelpText}" Margin="0,16,0,0" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="20,14">
                <Button Content="Close" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" MinWidth="90"
                        Click="Close_Click" IsDefault="True" />
            </Border>
        </Grid>
    </Border>
</Window>
