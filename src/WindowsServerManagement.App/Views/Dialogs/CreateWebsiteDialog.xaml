<Window x:Class="WindowsServerManagement.App.Views.Dialogs.CreateWebsiteDialog"
        Title="Create IIS Website"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:WindowsServerManagement.App.Converters"
        Width="860" Height="900" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
    </Window.Resources>
    <Border Margin="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.3" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Background="{DynamicResource TitleBarBrush}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource BrandGradientBrush}"
                        Margin="18,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Create IIS website" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ServerSummary}" Style="{StaticResource HelpText}" Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Content="&#xE711;" Style="{StaticResource IconButton}" Width="32" Height="32"
                        Margin="0,0,14,0" Command="{Binding CancelOrCloseCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16,24,12">
                <StackPanel>
                    <Border Background="{DynamicResource SuccessSoftBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14"
                            Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SuccessBrush}"
                                           FontSize="18" Margin="0,1,10,0" />
                                <TextBlock Text="Website created" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding ResultMessage}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,0" />
                            <TextBlock Text="{Binding WarningsText}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource WarningBrush}" Margin="0,8,0,0"
                                       Visibility="{Binding WarningsText, Converter={StaticResource StringToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                    </Border>

                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0}%}" Style="{StaticResource HelpText}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Website" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Website name" Style="{StaticResource FieldLabelText}" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Physical folder name" Style="{StaticResource FieldLabelText}" />
                            <TextBox Text="{Binding FolderName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                            <TextBlock Text="Port" Style="{StaticResource FieldLabelText}" />
                            <TextBox Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                            <TextBlock Text="Hostname (optional)" Style="{StaticResource FieldLabelText}" />
                            <TextBox Text="{Binding Hostname, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Leave blank for all unassigned host headers." Style="{StaticResource HelpText}" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Physical path on the remote server" Style="{StaticResource FieldLabelText}" />
                            <TextBlock Text="{Binding PhysicalPathPreview}" FontFamily="Consolas" FontSize="12"
                                       Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource HelpText}" Margin="0,4,0,0"><Run Text="IIS root: " /><Run Text="{Binding IisRoot}" /></TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionSeparator}" />
                    <TextBlock Text="Binding" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Protocol" Style="{StaticResource FieldLabelText}" />
                            <ComboBox ItemsSource="{Binding Protocols}" SelectedItem="{Binding SelectedProtocol}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Visibility="{Binding IsHttps, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="HTTPS certificate" Style="{StaticResource FieldLabelText}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Certificates}" SelectedItem="{Binding SelectedCertificate}"
                                          DisplayMemberPath="Display" Margin="0,0,8,0" />
                                <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCertificatesCommand}"
                                        IsEnabled="{Binding IsLoadingCertificates, Converter={StaticResource InverseBool}}" />
                            </Grid>
                            <TextBox Text="{Binding CertificateThumbprint, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"
                                     ToolTip="Certificate thumbprint in LocalMachine\My" />
                            <TextBlock Text="{Binding CertificateStatus}" Style="{StaticResource HelpText}" Margin="0,5,0,0" />
                            <TextBlock Text="Select a certificate or paste its 40-character SHA-1 thumbprint. The certificate must have a private key in LocalMachine\My."
                                       Style="{StaticResource HelpText}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SectionSeparator}" />
                    <TextBlock Text="Application pool" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Pool name" Style="{StaticResource FieldLabelText}" />
                            <TextBox Text="{Binding ApplicationPoolName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text=".NET CLR version" Style="{StaticResource FieldLabelText}" />
                            <TextBox Text="{Binding ApplicationPoolRuntime, Mode=OneWay}" IsReadOnly="True" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Pipeline mode" Style="{StaticResource FieldLabelText}" />
                            <TextBox Text="{Binding ApplicationPoolPipeline, Mode=OneWay}" IsReadOnly="True" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="The application pool is created with the default settings from Settings if it does not already exist. An existing pool is reused without modification."
                               Style="{StaticResource HelpText}" Margin="0,6,0,0" />

                    <Border Style="{StaticResource SectionSeparator}" />
                    <TextBlock Text="Options" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />
                    <CheckBox Content="Use the existing folder if it already exists" IsChecked="{Binding UseExistingFolder}" />
                    <CheckBox Content="Start the website immediately after creation" IsChecked="{Binding StartImmediately}" Margin="0,8,0,0" />
                    <TextBlock Text="The app pool identity receives Read &amp; Execute permission on the website folder. Existing folders are never overwritten. If creation fails, only resources created by this operation are rolled back."
                               Style="{StaticResource HelpText}" Margin="0,10,0,0" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Website creation runs over the selected SSH connection." Style="{StaticResource HelpText}"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Cancel" Command="{Binding CancelOrCloseCommand}" Margin="0,0,8,0"
                                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                        <Button Content="Close" Command="{Binding CancelOrCloseCommand}" Margin="0,0,8,0"
                                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Create website" Style="{StaticResource PrimaryButton}" Command="{Binding CreateCommand}"
                                IsEnabled="{Binding CanCreate}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
