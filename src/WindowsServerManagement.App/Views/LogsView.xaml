<UserControl x:Class="WindowsServerManagement.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:WindowsServerManagement.App.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
        <conv:ActivityStatusToBrushConverter x:Key="StatusBrush" />
        <conv:ActivityStatusToBackgroundConverter x:Key="StatusBackground" />
    </UserControl.Resources>

    <Grid Margin="30,24,30,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Activity Logs" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="A local audit trail of SSH connections, IIS changes, failures, and confirmations. Secrets are never logged."
                           Style="{StaticResource PageSubtitleText}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid MaxWidth="460" HorizontalAlignment="Left">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MinHeight="38" Padding="34,7,10,7" />
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" />
                <TextBlock Text="Search server, website, operation, or details..." Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center" Margin="34,0,0,0" IsHitTestVisible="False"
                           Visibility="{Binding SearchText, Converter={StaticResource StringToVisibility}, ConverterParameter=Invert}" />
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="Status" Style="{StaticResource FieldLabelText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Width="130" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" Margin="0,0,10,0" />
                <Button Content="Clear filters" Command="{Binding ClearFiltersCommand}" Style="{StaticResource SubtleButton}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid ItemsSource="{Binding EntriesView}" RowDetailsVisibilityMode="VisibleWhenSelected"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Timestamp" Binding="{Binding TimestampText}" Width="145" />
                        <DataGridTextColumn Header="Server" Binding="{Binding ServerName}" Width="140" />
                        <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="160" />
                        <DataGridTemplateColumn Header="Status" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusPill}" Background="{Binding Status, Converter={StaticResource StatusBackground}}"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                        <DataGridTextColumn Header="Duration" Binding="{Binding DurationMs, StringFormat={}{0} ms}" Width="90" />
                    </DataGrid.Columns>
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,1,0,1" Padding="16,12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Details" Style="{StaticResource FieldLabelText}" Margin="0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Id}" Style="{StaticResource HelpText}"
                                                   HorizontalAlignment="Right" FontFamily="Consolas" />
                                    </Grid>
                                    <TextBlock Text="{Binding Details}" TextWrapping="Wrap" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"
                                               Visibility="{Binding Details, Converter={StaticResource StringToVisibility}}" />
                                    <TextBlock Text="No additional error details were recorded for this entry."
                                               Style="{StaticResource HelpText}" Margin="0,6,0,0"
                                               Visibility="{Binding Details, Converter={StaticResource StringToVisibility}, ConverterParameter=Invert}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                            Visibility="{Binding HasVisibleEntries, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                               Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="No matching activity" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Text="Connect to a server or clear the filters to see activity." Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding FilteredCountText}" Style="{StaticResource HelpText}" />
            <TextBlock Text="Logs are stored locally under your Windows profile." Style="{StaticResource HelpText}"
                       HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</UserControl>
