<UserControl x:Class="WindowsServerManagement.App.Views.ServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:WindowsServerManagement.App.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:ConnectionStateToBrushConverter x:Key="StateBrush" />
        <conv:BooleanToBrushConverter x:Key="BooleanBrush" />
    </UserControl.Resources>

    <Grid Margin="20,14,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Servers" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="Manage connection profiles, SSH sessions, and server readiness."
                           Style="{StaticResource PageSubtitleText}" />
            </StackPanel>
            <Button Content="+  Add Server" Style="{StaticResource PrimaryButton}" Command="{Binding AddServerCommand}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Height="30" MinHeight="30" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="300" MinWidth="250" MaxWidth="480" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="2">
                <Grid>
                    <DataGrid ItemsSource="{Binding Catalog.Servers}" SelectedItem="{Binding Catalog.SelectedServer, Mode=TwoWay}"
                              RowHeight="34" ColumnHeaderHeight="31">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.2*" />
                            <DataGridTextColumn Header="Host" Binding="{Binding Endpoint}" Width="1.3*" />
                            <DataGridTextColumn Header="Username" Binding="{Binding Profile.Username}" Width="1.1*" />
                            <DataGridTemplateColumn Header="Status" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="{Binding ConnectionState, Converter={StaticResource StateBrush}}"
                                                     VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                                                       Foreground="{Binding ConnectionState, Converter={StaticResource StateBrush}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Last Connected" Binding="{Binding LastConnectedText}" Width="130" />
                            <DataGridTextColumn Header="Websites" Binding="{Binding WebsiteSummary}" Width="200" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="2"
                            Visibility="{Binding HasNoServers, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
                            <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                       Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="No server connections configured" FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,10,0,0" />
                            <TextBlock Text="Add a Windows Server profile to connect over SSH and manage IIS."
                                       Style="{StaticResource MutedText}" HorizontalAlignment="Center" TextAlignment="Center"
                                       Margin="0,4,0,10" />
                            <Button Content="Add Server" Style="{StaticResource PrimaryButton}" Command="{Binding AddServerCommand}"
                                    HorizontalAlignment="Center" Height="30" MinHeight="30" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                            Cursor="SizeWE" />

            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,0,0,1" Padding="12,9">
                        <StackPanel>
                            <TextBlock Text="Actions" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Catalog.SelectedServer.Name}" Style="{StaticResource HelpText}"
                                       FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <StackPanel Margin="10" VerticalAlignment="Center"
                                    Visibility="{Binding Catalog.SelectedServer, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}">
                            <TextBlock Text="Select a server" Style="{StaticResource MutedText}" TextAlignment="Center" />
                            <TextBlock Text="Connection and profile actions appear here." Style="{StaticResource HelpText}"
                                       TextAlignment="Center" Margin="0,3,0,0" />
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding Catalog.SelectedServer, Converter={StaticResource NullToVisibility}}">
                            <StackPanel Margin="6,6,6,10">
                                <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="2,4,2,8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{Binding Catalog.SelectedServer.ConnectionState, Converter={StaticResource StateBrush}}"
                                                     VerticalAlignment="Center" Margin="0,0,7,0" />
                                            <TextBlock Text="{Binding Catalog.SelectedServer.StatusMessage}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{Binding Catalog.SelectedServer.ConnectionState, Converter={StaticResource StateBrush}}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Catalog.SelectedServer.LastError}" Style="{StaticResource HelpText}"
                                                   FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   Visibility="{Binding Catalog.SelectedServer.LastError, Converter={StaticResource NullToVisibility}}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Connection" Style="{StaticResource FieldLabelText}" Margin="8,5,0,3" />
                                <Button Content="Connect" Style="{StaticResource ActionLinkButton}"
                                        Command="{Binding ConnectCommand}" CommandParameter="{Binding Catalog.SelectedServer}"
                                        Visibility="{Binding Catalog.SelectedServer.IsConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                <Button Content="Disconnect" Style="{StaticResource ActionLinkButton}"
                                        Command="{Binding DisconnectCommand}" CommandParameter="{Binding Catalog.SelectedServer}"
                                        Visibility="{Binding Catalog.SelectedServer.IsConnected, Converter={StaticResource BoolToVisibility}}" />
                                <Button Content="Reconnect" Style="{StaticResource ActionLinkButton}"
                                        Command="{Binding ReconnectCommand}" CommandParameter="{Binding Catalog.SelectedServer}" />
                                <Button Content="Test Connection" Style="{StaticResource ActionLinkButton}"
                                        Command="{Binding TestConnectionCommand}" CommandParameter="{Binding Catalog.SelectedServer}" />
                                <Button Content="Diagnostics" Style="{StaticResource ActionLinkButton}"
                                        Command="{Binding DiagnoseCommand}" CommandParameter="{Binding Catalog.SelectedServer}" />
                                <Button Content="Cancel Current Operation" Style="{StaticResource ActionLinkButton}"
                                        Command="{Binding CancelOperationCommand}" CommandParameter="{Binding Catalog.SelectedServer}"
                                        Visibility="{Binding Catalog.SelectedServer.IsBusy, Converter={StaticResource BoolToVisibility}}" />

                                <Border Style="{StaticResource SectionSeparator}" Margin="8,7" />

                                <TextBlock Text="Profile" Style="{StaticResource FieldLabelText}" Margin="8,5,0,3" />
                                <Button Content="Edit Server" Style="{StaticResource ActionLinkButton}"
                                        Command="{Binding EditServerCommand}" CommandParameter="{Binding Catalog.SelectedServer}" />
                                <Button Content="Forget Trusted Host Key" Style="{StaticResource ActionLinkButton}"
                                        Command="{Binding ForgetHostKeyCommand}" CommandParameter="{Binding Catalog.SelectedServer}"
                                        Visibility="{Binding Catalog.SelectedServer.HasTrustedHostKey, Converter={StaticResource BoolToVisibility}}" />
                                <Button Content="Delete Server Profile" Style="{StaticResource DangerActionLinkButton}"
                                        Command="{Binding DeleteServerCommand}" CommandParameter="{Binding Catalog.SelectedServer}" />

                                <Border Style="{StaticResource SectionSeparator}" Margin="8,7" />

                                <TextBlock Text="Details" Style="{StaticResource FieldLabelText}" Margin="8,5,0,5" />
                                <Grid Margin="8,0,8,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Endpoint" Style="{StaticResource HelpText}" FontSize="10" />
                                    <TextBlock Grid.Column="1" Text="{Binding Catalog.SelectedServer.Endpoint}" FontSize="10" />
                                </Grid>
                                <Grid Margin="8,0,8,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Username" Style="{StaticResource HelpText}" FontSize="10" />
                                    <TextBlock Grid.Column="1" Text="{Binding Catalog.SelectedServer.Profile.Username}" FontSize="10" />
                                </Grid>
                                <Grid Margin="8,0,8,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Authentication" Style="{StaticResource HelpText}" FontSize="10" />
                                    <TextBlock Grid.Column="1" Text="{Binding Catalog.SelectedServer.AuthenticationLabel}" FontSize="10" />
                                </Grid>
                                <Grid Margin="8,0,8,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="IIS readiness" Style="{StaticResource HelpText}" FontSize="10" />
                                    <TextBlock Grid.Column="1" Text="{Binding Catalog.SelectedServer.CapabilitySummary}" FontSize="10"
                                               Foreground="{Binding Catalog.SelectedServer.IsManagementReady, Converter={StaticResource BooleanBrush}}" />
                                </Grid>
                                <TextBlock Text="Trusted SSH host key" Style="{StaticResource HelpText}" FontSize="10" Margin="8,3,8,2" />
                                <TextBlock Text="{Binding Catalog.SelectedServer.FingerprintText}" FontFamily="Consolas" FontSize="9.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="8,0,8,5" />
                                <TextBlock Text="{Binding Catalog.SelectedServer.Profile.Notes}" Style="{StaticResource HelpText}"
                                           FontSize="10" TextWrapping="Wrap" Margin="8,3,8,0"
                                           Visibility="{Binding Catalog.SelectedServer.Profile.Notes, Converter={StaticResource NullToVisibility}}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
