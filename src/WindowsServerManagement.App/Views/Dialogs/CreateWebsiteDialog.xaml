<Window x:Class="WindowsServerManagement.App.Views.Dialogs.CreateWebsiteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:WindowsServerManagement.App.Converters"
        Title="Create IIS Website"
        Width="780" Height="760" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
        <Style x:Key="GroupPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>
    <Border Margin="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.25" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Background="{DynamicResource TitleBarBrush}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="3" Background="{DynamicResource BrandGradientBrush}"
                        Margin="16,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Create IIS website" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ServerSummary}" Style="{StaticResource HelpText}" Margin="0,1,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Content="&#xE711;" Style="{StaticResource IconButton}" Width="30" Height="30"
                        Margin="0,0,10,0" Command="{Binding CancelOrCloseCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,14,20,10">
                <StackPanel>
                    <Border Background="{DynamicResource SuccessSoftBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}"
                            BorderThickness="1" CornerRadius="2" Padding="12" Margin="0,0,0,10"
                            Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SuccessBrush}"
                                           FontSize="16" Margin="0,1,8,0" />
                                <TextBlock Text="Website created" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding ResultMessage}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding WarningsText}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource WarningBrush}" Margin="0,6,0,0"
                                       Visibility="{Binding WarningsText, Converter={StaticResource StringToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBorderBrush}"
                            BorderThickness="1" CornerRadius="2" Padding="10" Margin="0,0,0,10"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                    </Border>

                    <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1" CornerRadius="2" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0}%}" Style="{StaticResource HelpText}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Margin="0,6,0,0" Height="4" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GroupPanel}">
                        <StackPanel>
                            <TextBlock Text="Site" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Site name" Style="{StaticResource FieldLabelText}" />
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Physical path on the remote server" Style="{StaticResource FieldLabelText}" />
                                    <TextBox Text="{Binding PhysicalPath, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource HelpText}" Margin="0,5,0,0">
                                The folder is created on the selected remote server. It must be inside the configured IIS root
                                (<Run Text="{Binding IisRoot, Mode=OneWay}" />).
                            </TextBlock>
                            <CheckBox Content="Use the existing folder if it already exists" IsChecked="{Binding UseExistingFolder}"
                                      Margin="0,9,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GroupPanel}">
                        <StackPanel>
                            <TextBlock Text="Application pool" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Name" Style="{StaticResource FieldLabelText}" />
                                    <TextBox Text="{Binding ApplicationPoolName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text=".NET CLR version" Style="{StaticResource FieldLabelText}" />
                                    <ComboBox ItemsSource="{Binding RuntimeOptions}" SelectedItem="{Binding ApplicationPoolRuntimeVersion}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Managed pipeline mode" Style="{StaticResource FieldLabelText}" />
                                    <ComboBox ItemsSource="{Binding PipelineOptions}" SelectedItem="{Binding ApplicationPoolPipelineMode}" />
                                </StackPanel>
                            </Grid>
                            <CheckBox Content="Start application pool immediately" IsChecked="{Binding StartApplicationPoolImmediately}"
                                      Margin="0,9,0,0" />
                            <TextBlock Text="If the pool already exists, it is reused without changing its settings."
                                       Style="{StaticResource HelpText}" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GroupPanel}">
                        <StackPanel>
                            <TextBlock Text="Binding" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Type" Style="{StaticResource FieldLabelText}" />
                                    <ComboBox ItemsSource="{Binding Protocols}" SelectedItem="{Binding SelectedProtocol}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Port" Style="{StaticResource FieldLabelText}" />
                                    <TextBox Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Host name (optional)" Style="{StaticResource FieldLabelText}" />
                                    <TextBox Text="{Binding Hostname, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="IP address" Style="{StaticResource FieldLabelText}" VerticalAlignment="Center" Margin="0" />
                                <TextBlock Grid.Column="1" Text="All Unassigned (*)" Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Margin="0,10,0,0" Visibility="{Binding IsHttps, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="HTTPS certificate" Style="{StaticResource FieldLabelText}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding Certificates}" SelectedItem="{Binding SelectedCertificate}"
                                              DisplayMemberPath="Display" Margin="0,0,8,0" />
                                    <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCertificatesCommand}"
                                            IsEnabled="{Binding IsLoadingCertificates, Converter={StaticResource InverseBool}}" />
                                </Grid>
                                <TextBox Text="{Binding CertificateThumbprint, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,0"
                                         ToolTip="Certificate thumbprint in LocalMachine\My" />
                                <TextBlock Text="{Binding CertificateStatus}" Style="{StaticResource HelpText}" Margin="0,4,0,0" />
                                <TextBlock Text="The certificate must have a private key in LocalMachine\My on the remote server."
                                           Style="{StaticResource HelpText}" Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GroupPanel}">
                        <StackPanel>
                            <TextBlock Text="Options" Style="{StaticResource SectionTitleText}" Margin="0,0,0,8" />
                            <CheckBox Content="Start website immediately after creation" IsChecked="{Binding StartImmediately}" />
                            <TextBlock Text="The application pool identity receives Read &amp; Execute permission on the folder. A failed creation attempts to roll back only the resources created by this operation."
                                       Style="{StaticResource HelpText}" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,4,4" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Executes over the selected SSH connection." Style="{StaticResource HelpText}"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Cancel" Command="{Binding CancelOrCloseCommand}" Margin="0,0,8,0"
                                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                        <Button Content="Close" Command="{Binding CancelOrCloseCommand}" Margin="0,0,8,0"
                                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Create website" Style="{StaticResource PrimaryButton}" Command="{Binding CreateCommand}"
                                IsEnabled="{Binding CanCreate}"
                                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
