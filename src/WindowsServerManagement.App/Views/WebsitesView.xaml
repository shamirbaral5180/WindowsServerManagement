<UserControl x:Class="WindowsServerManagement.App.Views.WebsitesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:WindowsServerManagement.App.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
        <conv:ConnectionStateToBrushConverter x:Key="StateBrush" />
        <conv:BooleanToBrushConverter x:Key="BooleanBrush" />
    </UserControl.Resources>

    <Grid Margin="20,14,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="IIS Websites" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="Create and manage sites on the selected remote server." Style="{StaticResource PageSubtitleText}" />
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource HelpText}" HorizontalAlignment="Right"
                       VerticalAlignment="Bottom" Margin="0,0,2,1" MaxWidth="480" TextTrimming="CharacterEllipsis" />
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="2" Padding="8,5" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Server:" Style="{StaticResource HelpText}" VerticalAlignment="Center" Margin="2,0,6,0" />
                <ComboBox Grid.Column="1" Width="220" ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer, Mode=TwoWay}"
                          DisplayMemberPath="Name" Height="28" MinHeight="28" />
                <Button Grid.Column="2" Content="Connect" Command="{Binding ConnectServerCommand}" Margin="10,0,0,0"
                        Height="28" MinHeight="28" Padding="10,0"
                        Visibility="{Binding IsServerConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                <Grid Grid.Column="3" Margin="4,0,0,0">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="28" MinHeight="28" Padding="26,4,8,4" />
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                               VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False" />
                    <TextBlock Text="Search websites..." Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11"
                               VerticalAlignment="Center" Margin="27,0,0,0" IsHitTestVisible="False"
                               Visibility="{Binding SearchText, Converter={StaticResource StringToVisibility}, ConverterParameter=Invert}" />
                </Grid>
                <TextBlock Grid.Column="4" Text="{Binding FilteredCountText}" Style="{StaticResource HelpText}"
                           VerticalAlignment="Center" Margin="12,0,8,0" />
                <StackPanel Grid.Column="5" Orientation="Horizontal">
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Height="28" MinHeight="28" Padding="10,0" />
                    <Button Content="Create Website" Style="{StaticResource PrimaryButton}" Command="{Binding CreateWebsiteCommand}"
                            Margin="6,0,0,0" Height="28" MinHeight="28" Padding="10,0" />
                    <Button Content="Delete Site" Style="{StaticResource DangerButton}" Command="{Binding DeleteWebsiteCommand}"
                            IsEnabled="{Binding HasSelectedWebsite}" Margin="6,0,0,0" Height="28" MinHeight="28" Padding="10,0" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <Border Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBorderBrush}"
                    BorderThickness="1" CornerRadius="2" Padding="10,7" Margin="0,0,0,6"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource DangerBrush}"
                               FontSize="12" VerticalAlignment="Top" Margin="0,1,7,0" />
                    <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap" FontSize="11" />
                    <Button Grid.Column="2" Content="&#xE711;" Style="{StaticResource IconButton}" Command="{Binding ClearNotificationsCommand}"
                            Width="22" Height="22" MinHeight="22" />
                </Grid>
            </Border>
            <Border Background="{DynamicResource SuccessSoftBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}"
                    BorderThickness="1" CornerRadius="2" Padding="10,7" Margin="0,0,0,6"
                    Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SuccessBrush}"
                               FontSize="12" VerticalAlignment="Top" Margin="0,1,7,0" />
                    <TextBlock Grid.Column="1" Text="{Binding SuccessMessage}" Foreground="{DynamicResource SuccessBrush}"
                               TextWrapping="Wrap" FontSize="11" />
                    <Button Grid.Column="2" Content="&#xE711;" Style="{StaticResource IconButton}" Command="{Binding ClearNotificationsCommand}"
                            Width="22" Height="22" MinHeight="22" />
                </Grid>
            </Border>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="300" MinWidth="250" MaxWidth="480" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ProgressBar IsIndeterminate="True" Height="2" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding WebsitesView}" SelectedItem="{Binding SelectedWebsite, Mode=TwoWay}"
                              Margin="0,1,0,0" RowHeight="34" ColumnHeaderHeight="31">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Site" Binding="{Binding Name}" Width="1.3*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding State}" Width="76" />
                            <DataGridTextColumn Header="Binding" Binding="{Binding BindingsSummary}" Width="1.4*" />
                            <DataGridTextColumn Header="Physical Path" Binding="{Binding PhysicalPath}" Width="2*" />
                            <DataGridTextColumn Header="Application Pool" Binding="{Binding ApplicationPool}" Width="1.1*" />
                            <DataGridTextColumn Header="Server" Binding="{Binding ServerName}" Width="95" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                          Visibility="{Binding HasVisibleWebsites, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                          IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                       Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource MutedText}" TextAlignment="Center"
                                       FontSize="12" Margin="0,10,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                            Cursor="SizeWE" />

            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,0,0,1" Padding="12,9">
                        <StackPanel>
                            <TextBlock Text="Actions" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedWebsite.Name}" Style="{StaticResource HelpText}" FontSize="11"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6,6,6,10">
                            <TextBlock Text="Website" Style="{StaticResource FieldLabelText}" Margin="8,5,0,3" />
                            <Button Content="Start" Style="{StaticResource ActionLinkButton}" Command="{Binding StartWebsiteCommand}"
                                    IsEnabled="{Binding HasSelectedWebsite}"
                                    Visibility="{Binding SelectedWebsite.IsRunning, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                            <Button Content="Stop" Style="{StaticResource ActionLinkButton}" Command="{Binding StopWebsiteCommand}"
                                    IsEnabled="{Binding HasSelectedWebsite}"
                                    Visibility="{Binding SelectedWebsite.IsRunning, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="Restart" Style="{StaticResource ActionLinkButton}" Command="{Binding RestartWebsiteCommand}"
                                    IsEnabled="{Binding HasSelectedWebsite}"
                                    Visibility="{Binding SelectedWebsite.IsRunning, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="Open in Browser" Style="{StaticResource ActionLinkButton}"
                                    Command="{Binding OpenInBrowserCommand}" IsEnabled="{Binding HasSelectedWebsite}" />
                            <Button Content="Edit Bindings" Style="{StaticResource ActionLinkButton}"
                                    Command="{Binding EditBindingsCommand}" IsEnabled="{Binding HasSelectedWebsite}" />
                            <Button Content="View Configuration" Style="{StaticResource ActionLinkButton}"
                                    Command="{Binding ViewDetailsCommand}" IsEnabled="{Binding HasSelectedWebsite}" />
                            <Button Content="Delete Website" Style="{StaticResource DangerActionLinkButton}"
                                    Command="{Binding DeleteWebsiteCommand}" IsEnabled="{Binding HasSelectedWebsite}" />

                            <Border Style="{StaticResource SectionSeparator}" Margin="8,7" />

                            <TextBlock Text="Website List" Style="{StaticResource FieldLabelText}" Margin="8,5,0,3" />
                            <Button Content="Refresh" Style="{StaticResource ActionLinkButton}" Command="{Binding RefreshCommand}" />
                            <Button Content="Create Website" Style="{StaticResource ActionLinkButton}" Command="{Binding CreateWebsiteCommand}" />
                            <Button Content="Cancel Current Operation" Style="{StaticResource ActionLinkButton}"
                                    Command="{Binding CancelOperationCommand}"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                            <Border Style="{StaticResource SectionSeparator}" Margin="8,7" />

                            <TextBlock Text="Details" Style="{StaticResource FieldLabelText}" Margin="8,5,0,5" />
                            <StackPanel Visibility="{Binding HasSelectedWebsite, Converter={StaticResource BoolToVisibility}}">
                                <Grid Margin="8,0,8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Server" Style="{StaticResource HelpText}" FontSize="10" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedWebsite.ServerName}" FontSize="10"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <Grid Margin="8,0,8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="State" Style="{StaticResource HelpText}" FontSize="10" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedWebsite.State}" FontSize="10" />
                                </Grid>
                                <Grid Margin="8,0,8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="App pool" Style="{StaticResource HelpText}" FontSize="10" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedWebsite.ApplicationPool}" FontSize="10"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <TextBlock Text="Physical path" Style="{StaticResource HelpText}" FontSize="10" Margin="8,2,8,2" />
                                <TextBlock Text="{Binding SelectedWebsite.PhysicalPath}" FontFamily="Consolas" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="8,0,8,6" />
                                <TextBlock Text="Bindings" Style="{StaticResource HelpText}" FontSize="10" Margin="8,2,8,3" />
                                <ItemsControl ItemsSource="{Binding SelectedWebsite.Bindings}" Margin="8,0,8,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Display}" FontSize="10" Margin="0,1,0,2"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <TextBlock Text="Select a website to view actions and details." Style="{StaticResource HelpText}"
                                       Margin="8,2,8,0"
                                       Visibility="{Binding HasSelectedWebsite, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource HelpText}" FontSize="10" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Ellipse Width="6" Height="6" Fill="{Binding SelectedServer.ConnectionState, Converter={StaticResource StateBrush}}"
                         VerticalAlignment="Center" Margin="0,0,5,0" />
                <TextBlock Text="{Binding ServerName}" Style="{StaticResource HelpText}" FontSize="10" />
                <TextBlock Text="  |  " Style="{StaticResource HelpText}" FontSize="10" />
                <TextBlock Text="{Binding ServerEndpoint}" Style="{StaticResource HelpText}" FontSize="10" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
