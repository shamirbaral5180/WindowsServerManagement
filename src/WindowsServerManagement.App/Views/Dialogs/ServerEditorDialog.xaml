<Window x:Class="WindowsServerManagement.App.Views.Dialogs.ServerEditorDialog"
        Title="Server profile"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:WindowsServerManagement.App.Behaviors"
        xmlns:conv="clr-namespace:WindowsServerManagement.App.Converters"
        Width="760" Height="840" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
        <conv:AuthenticationMethodDisplayConverter x:Key="AuthDisplay" />
    </Window.Resources>
    <Border Margin="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.3" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Background="{DynamicResource TitleBarBrush}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource BrandGradientBrush}"
                        Margin="18,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding WindowTitle}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="SSH connection profile" Style="{StaticResource HelpText}" Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Content="&#xE711;" Style="{StaticResource IconButton}" Width="32" Height="32"
                        Margin="0,0,14,0" Command="{Binding CancelCommand}" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,18,24,10">
                <StackPanel>
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Foreground="{DynamicResource AccentBrush}" Margin="0,1,9,0" />
                            <TextBlock Text="Secrets are encrypted with Windows DPAPI for your Windows account. Host keys are verified and pinned."
                                       Style="{StaticResource MutedText}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Server" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Display name" Style="{StaticResource FieldLabelText}" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Hostname or IP address" Style="{StaticResource FieldLabelText}" />
                            <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                            <TextBlock Text="SSH port" Style="{StaticResource FieldLabelText}" />
                            <TextBox Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                            <TextBlock Text="Username" Style="{StaticResource FieldLabelText}" />
                            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,14,0,0">
                            <TextBlock Text="Authentication method" Style="{StaticResource FieldLabelText}" />
                            <ComboBox Width="260" HorizontalAlignment="Left" ItemsSource="{Binding AuthenticationMethods}"
                                      SelectedItem="{Binding AuthenticationMethod}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource AuthDisplay}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SectionSeparator}" />
                    <TextBlock Text="Credential" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12" />
                    <StackPanel Visibility="{Binding IsPasswordAuthentication, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Password" Style="{StaticResource FieldLabelText}" />
                        <PasswordBox behaviors:PasswordBoxAssistant.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsPrivateKeyAuthentication, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Private key file" Style="{StaticResource FieldLabelText}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding PrivateKeyPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                            <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowsePrivateKeyCommand}" />
                        </Grid>
                        <TextBlock Text="Supported formats include OpenSSH RSA/ECDSA/Ed25519 and PuTTY PPK." Style="{StaticResource HelpText}" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding SecretLabel}" Style="{StaticResource FieldLabelText}" Margin="0,14,0,6" />
                        <PasswordBox behaviors:PasswordBoxAssistant.BoundPassword="{Binding Passphrase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <TextBlock Text="{Binding SecretHint}" Style="{StaticResource HelpText}" Margin="0,6,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                Visibility="{Binding HasStoredSecret, Converter={StaticResource BoolToVisibility}}">
                        <CheckBox Content="Clear the saved secret" IsChecked="{Binding ClearStoredSecret}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <CheckBox Content="Forget the trusted SSH host key on save" IsChecked="{Binding ForgetTrustedHostKey}" />
                        <TextBlock Text="{Binding FingerprintText}" Style="{StaticResource HelpText}" Margin="14,1,0,0"
                                   FontFamily="Consolas" />
                    </StackPanel>

                    <Border Style="{StaticResource SectionSeparator}" />
                    <TextBlock Text="Notes" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="62" MaxHeight="100" VerticalContentAlignment="Top" Padding="10,8" />

                    <Border Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,18,0,0"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                    </Border>

                    <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,0"
                            Visibility="{Binding TestSummary, Converter={StaticResource StringToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding TestSummary}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding TestDetails}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0"
                                       Visibility="{Binding TestDetails, Converter={StaticResource StringToVisibility}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="Test connection" Command="{Binding TestConnectionCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="110" Height="3" HorizontalAlignment="Left"
                                 VerticalAlignment="Center" Margin="16,0,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                        <Button Content="{Binding SaveLabel}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
