<Window x:Class="WindowsServerManagement.App.Views.Dialogs.BindingsEditorDialog"
        Title="Edit website bindings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:WindowsServerManagement.App.Converters"
        Width="980" Height="700" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
    </Window.Resources>
    <Border Margin="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.3" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Background="{DynamicResource TitleBarBrush}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource BrandGradientBrush}"
                        Margin="18,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="16" FontWeight="SemiBold"><Run Text="Edit bindings - " /><Run Text="{Binding WebsiteName, Mode=OneWay}" /></TextBlock>
                    <TextBlock Text="{Binding ServerName}" Style="{StaticResource HelpText}" Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Content="&#xE711;" Style="{StaticResource IconButton}" Width="32" Height="32"
                        Margin="0,0,14,0" Command="{Binding CancelCommand}" />
            </Grid>

            <Grid Grid.Row="1" Margin="24,16,24,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                    <TextBlock Text="Changing bindings can briefly interrupt the website. The operation attempts to restore the previous bindings if any change fails."
                               Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" FontSize="12" />
                </Border>

                <Border Grid.Row="1" Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                    <DataGrid ItemsSource="{Binding Bindings}" IsReadOnly="False" RowHeight="54" AutoGenerateColumns="False"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Protocol" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding Protocols}" SelectedItem="{Binding Protocol, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="0,4" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Port" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Hostname (optional)" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Hostname, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="HTTPS certificate thumbprint" Width="280">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding CertificateThumbprint, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"
                                                 FontFamily="Consolas" FontSize="11" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="54">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="&#xE74D;" Style="{StaticResource IconButton}" ToolTip="Remove binding"
                                                Command="{Binding DataContext.RemoveBindingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Each HTTPS binding must reference a certificate with a private key in LocalMachine\My." Style="{StaticResource HelpText}" />
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,3,0,0"><Run Text="Physical path: " /><Run Text="{Binding PhysicalPath, Mode=OneWay}" /></TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1" Content="+  Add binding" Command="{Binding AddBindingCommand}" VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource HelpText}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                        <Button Content="Save bindings" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
