<Window x:Class="WindowsServerManagement.App.Views.Dialogs.ConfirmationDialog"
        Title="Confirm action"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Border Margin="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.3" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Height="52" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource WarningSoftBrush}" Margin="16,0,10,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="IconGlyph" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" />
                <Button Grid.Column="2" Content="&#xE711;" Style="{StaticResource IconButton}" Width="30" Height="30" MinHeight="30"
                        Margin="0,0,10,0" Click="Cancel_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1" MaxHeight="360" VerticalScrollBarVisibility="Auto" Margin="20,4,20,18">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="20" />
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="20,0,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Review this action carefully." Style="{StaticResource HelpText}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CancelButton" Content="Cancel" Margin="0,0,8,0" Click="Cancel_Click" />
                    <Button x:Name="ConfirmButton" Content="Confirm" Style="{StaticResource PrimaryButton}" Click="Confirm_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
