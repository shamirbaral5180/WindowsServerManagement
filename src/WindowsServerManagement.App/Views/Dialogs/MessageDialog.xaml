<Window x:Class="WindowsServerManagement.App.Views.Dialogs.MessageDialog"
        Title="Server Manager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Border Margin="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.3" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Height="52" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="IconBackground" Width="30" Height="30" CornerRadius="8"
                        Background="{DynamicResource AccentSoftBrush}" Margin="16,0,10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="IconGlyph" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" />
                <Button Grid.Column="2" Content="&#xE711;" Style="{StaticResource IconButton}" Width="30" Height="30" MinHeight="30"
                        Margin="0,0,10,0" Click="Close_Click" />
            </Grid>
            <ScrollViewer Grid.Row="1" MaxHeight="420" VerticalScrollBarVisibility="Auto" Margin="20,4,20,18">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13" LineHeight="20"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </ScrollViewer>
            <Button Grid.Row="2" Content="OK" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                    Margin="20,0,20,20" MinWidth="90" Click="Close_Click" IsDefault="True" />
        </Grid>
    </Border>
</Window>
