<UserControl x:Class="WindowsServerManagement.App.Views.ServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:WindowsServerManagement.App.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:ConnectionStateToBrushConverter x:Key="StateBrush" />
        <conv:BooleanToBrushConverter x:Key="BooleanBrush" />
        <conv:AuthenticationMethodDisplayConverter x:Key="AuthDisplay" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
    </UserControl.Resources>

    <Grid Margin="30,24,30,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Servers" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="Manage connection profiles and independent SSH sessions for each Windows server."
                           Style="{StaticResource PageSubtitleText}" />
            </StackPanel>
            <Button Grid.Column="1" Content="+  Add server" Style="{StaticResource PrimaryButton}"
                    Command="{Binding AddServerCommand}" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="390" />
            </Grid.ColumnDefinitions>

            <Grid>
                <ListBox ItemsSource="{Binding Catalog.Servers}"
                         SelectedItem="{Binding Catalog.SelectedServer, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource ServerListBoxItem}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="16,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource BrandGradientBrush}"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="17" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Endpoint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding AuthenticationLabel}" Style="{StaticResource HelpText}" />
                                        <TextBlock Text="  ·  " Style="{StaticResource HelpText}" />
                                        <TextBlock Text="{Binding LastConnectedText}" Style="{StaticResource HelpText}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding WebsiteSummary}" Style="{StaticResource HelpText}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <Border Style="{StaticResource StatusPill}" Background="{DynamicResource SurfaceAltBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="{Binding ConnectionState, Converter={StaticResource StateBrush}}"
                                                     VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding StatusMessage}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{Binding ConnectionState, Converter={StaticResource StateBrush}}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding CapabilitySummary}" Style="{StaticResource HelpText}" HorizontalAlignment="Right"
                                               Margin="0,7,0,0"
                                               Foreground="{Binding IsManagementReady, Converter={StaticResource BooleanBrush}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Style="{StaticResource Card}" Padding="30"
                        Visibility="{Binding HasNoServers, Converter={StaticResource BoolToVisibility}}"
                        VerticalAlignment="Top" Margin="0,0,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="58" Height="58" CornerRadius="14" Background="{DynamicResource IconTileBrush}">
                            <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="No servers yet" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" />
                        <TextBlock Text="Add your first Windows Server profile. Your password is stored with Windows DPAPI, not in plain text."
                                   Style="{StaticResource MutedText}" HorizontalAlignment="Center" TextAlignment="Center"
                                   MaxWidth="430" Margin="0,6,0,14" />
                        <Button Content="Add server" Style="{StaticResource PrimaryButton}" Command="{Binding AddServerCommand}"
                                HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0"
                    Visibility="{Binding Catalog.SelectedServer, Converter={StaticResource NullToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding Catalog.SelectedServer}" Margin="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource BrandGradientBrush}">
                                <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="17" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,8,0">
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Endpoint}" Style="{StaticResource MutedText}" FontSize="12" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE70F;"
                                    ToolTip="Edit server" Command="{Binding DataContext.EditServerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </Grid>

                        <Border Margin="0,16,0,0" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" Fill="{Binding ConnectionState, Converter={StaticResource StateBrush}}"
                                             VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold"
                                               Foreground="{Binding ConnectionState, Converter={StaticResource StateBrush}}" />
                                    <TextBlock Text="{Binding LastConnectedText}" Style="{StaticResource HelpText}" Margin="12,1,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding LastError}" Style="{StaticResource HelpText}" Margin="0,7,0,0"
                                           Foreground="{DynamicResource DangerBrush}"
                                           Visibility="{Binding LastError, Converter={StaticResource NullToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Connection details" Style="{StaticResource SectionTitleText}" Margin="0,18,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28" />
                                <RowDefinition Height="28" />
                                <RowDefinition Height="28" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Username" Style="{StaticResource MutedText}" />
                            <TextBlock Grid.Column="1" Text="{Binding Profile.Username}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1" Text="Authentication" Style="{StaticResource MutedText}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AuthenticationLabel}" FontSize="12" />
                            <TextBlock Grid.Row="2" Text="Websites" Style="{StaticResource MutedText}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WebsiteSummary}" FontSize="12" />
                            <TextBlock Grid.Row="3" Text="Host key" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FingerprintText}" FontFamily="Consolas" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>

                        <Border Margin="0,16,0,0" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding IsManagementReady, Converter={StaticResource BooleanBrush}}"
                                               FontSize="15" Margin="0,0,8,0" />
                                    <TextBlock Text="Connection diagnostics" FontWeight="SemiBold" FontSize="13" />
                                </StackPanel>
                                <TextBlock Text="{Binding CapabilitySummary}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                                <Button Content="Run diagnostics" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                                        Margin="0,6,0,0" Command="{Binding DataContext.DiagnoseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding Profile.Notes}" Style="{StaticResource MutedText}" Margin="0,12,0,0"
                                   Visibility="{Binding Profile.Notes, Converter={StaticResource NullToVisibility}}" />

                        <Border Style="{StaticResource SectionSeparator}" />

                        <TextBlock Text="Actions" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />
                        <UniformGrid Columns="2">
                            <Button Content="Connect" Style="{StaticResource PrimaryButton}" Margin="0,0,5,8"
                                    Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                            <Button Content="Disconnect" Margin="0,0,5,8"
                                    Command="{Binding DataContext.DisconnectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="Reconnect" Margin="0,0,5,8"
                                    Command="{Binding DataContext.ReconnectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <Button Content="Test connection" Margin="0,0,5,8"
                                    Command="{Binding DataContext.TestConnectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <Button Content="Diagnostics" Margin="0,0,5,0"
                                    Command="{Binding DataContext.DiagnoseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <Button Content="Forget host key" Margin="0,0,5,0"
                                    Command="{Binding DataContext.ForgetHostKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding HasTrustedHostKey, Converter={StaticResource BoolToVisibility}}" />
                        </UniformGrid>
                        <Button Content="Cancel current operation" Style="{StaticResource SubtleButton}" Margin="0,10,0,0"
                                Command="{Binding DataContext.CancelOperationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Delete server profile" Style="{StaticResource DangerButton}" Margin="0,14,0,0"
                                Command="{Binding DataContext.DeleteServerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
